{
  "identifier": "com.smartclipboard.native-acceptance",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SmartClipboard native acceptance",
        "width": 400,
        "height": 550,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": true,
        "skipTaskbar": true,
        "resizable": false,
        "transparent": true
      }
    ],
    "security": {
      "capabilities": [
        "default",
        {
          "identifier": "native-webdriver-test",
          "windows": ["main"],
          "permissions": ["wdio-webdriver:default"]
        }
      ]
    }
  }
}
